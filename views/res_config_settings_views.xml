<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.is_theme_entreprise</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='companies_setting_container']" position="after">
                <block title="Thème de l'entreprise" name="is_theme_entreprise_setting_container">
                    <setting id="is_theme_couleur_setting" string="Couleur de l'entreprise" company_dependent="1"
                             help="Barre de menus, boutons, liens, cases cochées. Vide = thème Odoo standard. Recharger la page (F5) après modification.">
                        <div class="d-flex align-items-center gap-2">
                            <field name="is_theme_couleur" widget="color"/>
                            <field name="is_theme_couleur" placeholder="#EF582C" class="w-auto"/>
                        </div>
                        <div class="d-flex align-items-center gap-2 mt-2">
                            <label for="is_theme_eclaircissement" string="Couleur claire (onglets, en-têtes de tableaux) : éclaircissement en %"/>
                            <field name="is_theme_eclaircissement" class="w-auto"/>
                            <field name="is_theme_couleur_claire" widget="color" readonly="1"/>
                        </div>
                    </setting>
                    <setting id="is_theme_label_nowrap_setting" company_dependent="1"
                             help="Le nom des champs des formulaires reste sur une seule ligne">
                        <field name="is_theme_label_nowrap"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
