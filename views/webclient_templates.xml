<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Couleurs injectées côté serveur : en place avant le premier affichage, sans JS -->
    <template id="webclient_bootstrap" inherit_id="web.webclient_bootstrap">
        <xpath expr="//t[@t-set='head']" position="before">
            <t t-set="is_theme" t-value="request.env['res.company']._is_theme_valeurs()"/>
        </xpath>
        <xpath expr="//t[@t-set='head']" position="inside">
            <style t-if="is_theme['css']" t-out="is_theme['css']"/>
        </xpath>
        <!-- En v20, body_classname est passé en attribut du t-call (chaîne formatée) -->
        <xpath expr="//t[@t-call='web.layout']" position="attributes">
            <attribute name="body_classname.f">o_web_client {{ is_theme['classes'] }}</attribute>
        </xpath>
    </template>
</odoo>
